{
  "openapi": "3.0.0",
  "info": {
    "title": "HwGDReqs API",
    "version": "1.7.0",
    "description": "API for interacting with the Geometry Dash Request Queue"
  },
  "paths": {
    "/queue": {
      "get": {
        "summary": "Get the current queue",
        "parameters": [
          {
            "name": "row",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Get a specific row from the queue"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "levels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "aredl_position": {
                            "type": "integer",
                            "description": "The rank of the level on the AREDL (if applicable)"
                          },
                          "requester": {
                            "type": "string",
                            "description": "Display name of the requester (Twitch login or YouTube channel name)"
                          },
                          "requester2": {
                            "type": "string",
                            "description": "Platform user/channel ID: Twitch user-id or YouTube channelId"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Clear the queue",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/queue/count": {
      "get": {
        "summary": "Get the number of levels in the queue",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/current": {
      "get": {
        "summary": "Get the current level",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "object",
                      "properties": {
                        "aredl_position": {
                          "type": "integer",
                          "description": "The rank of the level on the AREDL (if applicable)"
                        },
                        "requester": {
                          "type": "string",
                          "description": "Display name of the requester"
                        },
                        "requester2": {
                          "type": "string",
                          "description": "Platform user/channel ID"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/add": {
      "post": {
        "summary": "Add a level to the queue (POST)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requester",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prio",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Set to true to prioritize this level"
          },
          {
            "name": "platform-icon",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "URL or path to a platform icon"
          },
          {
            "name": "requester2",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Platform user/channel ID for the requester (e.g. Twitch user-id or YouTube channelId). Used for ID-based blacklisting."
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/replace": {
      "post": {
        "summary": "Replace a level in the queue (POST)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Old level ID"
          },
          {
            "name": "new_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "New level ID"
          },
          {
            "name": "requester",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform-icon",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "URL or path to a platform icon"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/delete": {
      "post": {
        "summary": "Delete a level from the queue (POST)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/blacklist": {
      "get": {
        "summary": "Get blacklisted levels, authors, and requesters",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/blacklistlevel": {
      "post": {
        "summary": "Blacklist a level (POST)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/banauthor": {
      "post": {
        "summary": "Ban an author (POST)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/banrequester": {
      "post": {
        "summary": "Ban a requester by name (and their platform ID if known) (POST)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Level ID whose requester should be banned"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/banrequester2": {
      "post": {
        "summary": "Blacklist a requester by platform ID directly (POST)",
        "parameters": [
          {
            "name": "requester2",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Platform user/channel ID to blacklist (eg Twitch user-id or YouTube channelId)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/bantwitch": {
      "post": {
        "summary": "Ban a requester on Twitch (POST)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/clear": {
      "post": {
        "summary": "Clear the queue (POST)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/requests-on": {
      "post": {
        "summary": "Enable requests (POST)",
        "parameters": [
          {
            "name": "send-twitch",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/requests-off": {
      "post": {
        "summary": "Disable requests (POST)",
        "parameters": [
          {
            "name": "send-twitch",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/requests-state": {
      "get": {
        "summary": "Get requests enabled state",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search the queue",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}