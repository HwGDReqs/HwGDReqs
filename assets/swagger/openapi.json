    "/bantwitch": {
      "post": {
        "summary": "Ban a requester on Twitch (requires Twitch session with moderation scope)",
        "description": "Issues a Twitch ban for the requester of the given queue entry. Requires an active Twitch session with channel moderation enabled.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Queue entry level ID whose requester to ban on Twitch.",
                    "example": "10565740"
                  }
                }
              },
              "example": {
                "id": "10565740"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User banned on Twitch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "400": {
            "description": "Various error conditions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missing_id": {
                    "value": {
                      "ok": false,
                      "error": "missing_id"
                    }
                  },
                  "no_twitch_session": {
                    "value": {
                      "ok": false,
                      "error": "no_twitch_session"
                    }
                  },
                  "moderation_not_enabled": {
                    "value": {
                      "ok": false,
                      "error": "moderation_not_enabled"
                    }
                  },
                  "cannot_ban_self": {
                    "value": {
                      "ok": false,
                      "error": "cannot_ban_self"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Entry not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "ok": false,
                  "error": "not_found"
                }
              }
            }
          }
        }
      }
    },
    "/requests-on": {
      "post": {
        "summary": "Enable requests",
        "description": "Turns on request acceptance. Optionally sends a chat message via Twitch to announce it.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "send-twitch": {
                    "type": "boolean",
